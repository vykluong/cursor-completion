# ---------------------------------------------------------------------------
# worker
# ---------------------------------------------------------------------------
# The worker options belong to "agent worker" itself and are given before
# the subcommand. --pool takes an optional value; the CLI rewrites argv
# before commander so that "--pool <word>" keeps <word> as the pool name
# unless it is one of start, controller, debug or help.
_cursor_agent_worker() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  # --label and --labels-file exclude each other: the CLI's own descriptions
  # say they cannot be combined (checked in the action, not by .conflicts()).
  local -a worker_options=(
    '--auth-token-file[Path to a file containing the worker auth token]:token file:_files'
    "--clone-git-repos[Check out the claimed agent's Git repositories in the worker directory (any-repo pool workers only)]"
    "--computer-use[Let claimed cloud agents drive this machine's desktop (screenshot, click, type)]"
    '--connect-workspace[Let Cursor connect to the live workspace of agents this worker runs (Linux only)]'
    '--data-dir[Base directory for logs, artifacts, and recording data (can also use CURSOR_DATA_DIR env var)]:directory:_directories'
    '--debug[Print worker debug diagnostics before starting bridge mode]'
    '--display[Existing X11 display to require for --computer-use (Linux only)]:X11 display:'
    '(-h --help)'{-h,--help}'[Display help for command]'
    '--identity-socket[Expose a per-claim OIDC identity socket to claimed agents]'
    '--idle-release-timeout[Seconds the worker may stay connected while idle before it is released (0 disables)]:seconds:'
    '(--labels-file)*--label[Add a label to the worker (format: key=value, can be used multiple times)]:key=value:'
    '(--label)--labels-file[Path to a JSON or TOML file containing labels (can also use CURSOR_WORKER_LABELS_FILE env var)]:labels file:_files'
    '--management-addr[Listen address for an optional HTTP server with health, readiness, and metrics endpoints]:address (for example :8080):'
    '--mint-github-token[Receive short-lived GitHub tokens during claimed runs (pool workers only)]'
    '--name[Custom display name for this worker (can also use CURSOR_WORKER_NAME env var)]:worker name:'
    '--on-session-end[Add a worker-host sessionEnd command before pool claim teardown]:command:'
    '--on-session-start[Add a worker-host sessionStart command after a pool claim]:command:'
    '--pool[Join a team Self-Hosted Pool instead of registering a personal My Machines worker]::pool name (defaults to default):'
    '--pool-name[Deprecated alias for --pool <name> (can also use CURSOR_WORKER_POOL_NAME env var)]:pool name:'
    "--share-desktop[Let authorized viewers watch this worker's desktop through Cursor]::mode:(view view_and_control)"
    '--single-use[Same as --pool (legacy alias)]'
    '--sync-dashboard-secrets[Receive eligible dashboard Cloud Agent secrets as environment variables (pool workers only)]'
    '--wait[Wait for another worker using this data directory to stop (no value waits indefinitely)]::seconds:'
    '*--worker-dir[Workspace root to expose to agents (repeatable)]:directory:_directories'

    # Hidden: absent from "agent worker --help". Registered as
    # new Option(...).hideHelp() in ./src/cli.ts and verified by the drift
    # tool's missing-argument probe.
    '--worker-api-socket[Unix-domain socket path for an optional gRPC API exposing worker metadata and status]:socket path:_files'
    '--worker-id[Explicit, stable worker id to register with (can also use CURSOR_AGENT_WORKER_ID env var)]:worker ID:'
  )

  # A stop word right after --pool is the subcommand, not the pool name, so
  # drop the optional value from the --pool spec for this call.
  local -i pool=${words[(i)--pool]}
  if (( pool + 1 < CURRENT )) && [[ $words[pool+1] == (start|controller|debug|help) ]]; then
    worker_options[(r)--pool\[*]=${worker_options[(r)--pool\[*]%%::*}
  fi

  # Right after a bare --pool, any word but a stop word becomes the pool
  # name, so offer only the stop words as commands there (not self-test).
  # _cursor_agent_worker_commands sees pool_stop_words by dynamic scoping.
  local -i pool_stop_words=0
  [[ $words[CURRENT-1] == --pool && $words[CURRENT] != -* ]] && pool_stop_words=1

  _arguments -C -A '-*' \
    $worker_options \
    '1: :_cursor_agent_worker_commands' \
    '*:: :->sub'

  case $state in
    sub)
      case $words[1] in
        controller) _cursor_agent_worker_controller ;;
        debug)      _cursor_agent_worker_debug ;;
        help)       _cursor_agent_worker_help ;;
        self-test)  _cursor_agent_worker_self_test ;;
        start)      _cursor_agent_worker_start ;;
      esac
      ;;
  esac
}

_cursor_agent_worker_commands() {
  local -a commands hidden_commands
  commands=(
    'controller:Claim pending pool requests or keep warm workers, running a spawn hook for each'
    'debug:Run private worker preflight diagnostics for auth, privacy, routing, and visibility'
    'help:Display help for command'
    'start:Start the worker and connect to Cursor'
  )
  # Hidden: absent from "agent worker --help". Registered as .command(name,
  # {hidden:!0}) in ./src/cli.ts and verified by the drift tool, which found
  # the command's own usage line in its --help output.
  hidden_commands=(
    'self-test:Verify this build can analyze a shell command with its tree-sitter natives'
  )
  _describe -t commands 'worker commands' commands
  # After a bare --pool, only the stop words (start, controller, debug,
  # help), which are exactly the visible commands, stay the subcommand.
  (( ${pool_stop_words:-0} )) && return
  _describe -t hidden-commands 'hidden commands' hidden_commands
}

