# ---------------------------------------------------------------------------
# persist
# ---------------------------------------------------------------------------
# persist is parsed by hand before commander runs. Only the word right after
# "persist" can be list, attach or stop (or -h/--help); anything else is
# forwarded to the root command, so "agent persist [options] [prompt...]"
# takes the root options and a prompt. global_options is the local array of
# _cursor_agent, visible here through zsh's dynamic scoping.
_cursor_agent_persist() {
  if (( CURRENT == 2 )); then
    _arguments \
      $global_options \
      '1: :_cursor_agent_persist_commands'
    return
  fi

  if [[ $words[2] == (-h|--help) ]]; then
    # The hand-rolled parser prints usage and exits; nothing follows.
    _message 'no more arguments'
    return
  fi

  if [[ $words[2] != (attach|help|list|stop) ]]; then
    # The first word after persist began the forwarded root argv: keep
    # offering root options, and accept free-text prompt words.
    _arguments \
      $global_options \
      '*:prompt:'
    return
  fi

  # Drop "persist" so the leaf sees its own name as words[1].
  shift words
  (( CURRENT-- ))
  case $words[1] in
    attach) _cursor_agent_persist_attach ;;
    help)   _cursor_agent_persist_help ;;
    list)   _cursor_agent_persist_list ;;
    stop)   _cursor_agent_persist_stop ;;
  esac
}

_cursor_agent_persist_commands() {
  local -a commands
  commands=(
    'attach:Attach to a persistent session'
    'help:Display help for command'
    'list:List persistent sessions'
    'stop:Stop a persistent session'
  )
  _describe -t commands 'persist commands' commands
}

# The persist leaves take exactly the words their usage shows. -h/--help is
# deliberately not offered: the hand-rolled parser reads it as the session
# name after attach/stop, and as a usage error after list.
