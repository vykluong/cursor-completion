# --- Gated command trees ---
# Each tree below is gate-dependent (Statsig, per account) and known from
# static mining only. automations, cloud and env carry their own action, so
# commander adds no builtin help subcommand to them; only automations runs
# (subcommands, no action) has one.

# ---------------------------------------------------------------------------
# automations (gated)
# ---------------------------------------------------------------------------
_cursor_agent_automations() {
  local curcontext="$curcontext" state line context
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Display help for command]' \
    '1: :_cursor_agent_automations_commands' \
    '*:: :->args'

  case $state in
    args)
      case $words[1] in
        adopt)    _cursor_agent_automations_adopt ;;
        delete)   _cursor_agent_automations_delete ;;
        deploy)   _cursor_agent_automations_deploy ;;
        get)      _cursor_agent_automations_get ;;
        list)     _cursor_agent_automations_list ;;
        pull)     _cursor_agent_automations_pull ;;
        runs)     _cursor_agent_automations_runs ;;
        test)     _cursor_agent_automations_test ;;
        validate) _cursor_agent_automations_validate ;;
      esac
      ;;
  esac
}

